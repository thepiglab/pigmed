# Example site configuration for running PigMed on a Slurm cluster.
# Copy to a path OUTSIDE version control (e.g. local/<site>/env.sh, which is gitignored), fill in,
# then `export PIGMED_ENV=/abs/path/to/that/file` before using scripts/ or examples/slurm/.
export PIGMED_ROOT=/path/to/your/project/storage/pigmed     # persistent, group-owned storage
export PIGMED_ENV="$PIGMED_ROOT/code/local/<site>/env.sh"    # where this file lives on the cluster
export PIGMED_CODE="$PIGMED_ROOT/code"                       # rsynced copy of this repository
export PIGMED_WORK="$PIGMED_ROOT/work"                       # plans/, runs-*/ (bundle outbox), logs/
export HF_HOME="$PIGMED_ROOT/cache/huggingface"
# Hugging Face auth: run `hf auth login` once on the cluster (token stays in $HOME, mode 600) and point at it.
# Moving HF_HOME would otherwise hide that token. Do NOT put tokens in this file, .env, or the repository.
export HF_TOKEN_PATH="$HOME/.cache/huggingface/token"
export UV_CACHE_DIR="$PIGMED_ROOT/cache/uv"
export UV_PYTHON_INSTALL_DIR="$PIGMED_ROOT/cache/uv-python"
export UV_PROJECT_ENVIRONMENT="$PIGMED_ROOT/venv"
export UV_PYTHON_PREFERENCE=only-managed
export XDG_CACHE_HOME="$PIGMED_ROOT/cache/xdg"
export CARGO_HOME="$PIGMED_ROOT/cache/cargo"
export RUSTUP_HOME="$PIGMED_ROOT/cache/rustup"
export CARGO_TARGET_DIR="$PIGMED_ROOT/target"
export PATH="$CARGO_HOME/bin:$HOME/.local/bin:$PATH"
export PIGMED_RS="$CARGO_TARGET_DIR/release/pigmed-rs"
export PIGMED_PDFIUM_SRC="$UV_PROJECT_ENVIRONMENT/lib/python3.12/site-packages/pypdfium2_raw/libpdfium.so"
# Read natively by sbatch; keeps account/QOS names out of the repository.
export SBATCH_ACCOUNT=<your-account>
export SBATCH_QOS=<your-qos>
umask 0002

# --- Rust embedding runner (rust/pigmed-embed, examples/slurm/embed-rs-*.sbatch). Use a separate env file for it,
# e.g. local/<site>/embed/env.sh, and pass it to jobs as EMBED_ENV:
# export EMBED_ROOT=/path/to/your/project/storage/pigmed/embed-rs   # code copy, toolchains, venv, HF cache, ONNX, outputs
# export EMBED_ENV="$EMBED_ROOT/local/env.sh"                         # where that env file lives on the cluster
# export EMBED_BUNDLES="/path/to/bundle-dir-1 /path/to/bundle-dir-2"  # PigMed bundles used as image benchmark inputs
# export SBATCH_ACCOUNT=<your-account>; export SBATCH_QOS=<your-qos>
# source "$EMBED_ROOT/code/py/env.sh"
